[19.427, "o", "\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\r\n\u2502 \u001b[1m\u001b[36mkitgrove\u001b[39m\u001b[22m \u00b7 my-cms\u001b[2m \u00b7 Home\u001b[22m                                                                         \u2502\r\n\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\r\n\r\n \u001b[2mProject: my-cms\u001b[22m\r\n\r\n \u001b[1m\u001b[36m\u203a Collections\u001b[2m  browse and open\u001b[22m\u001b[39m\r\n   New collection\u001b[2m  fields, access, useAsTitle\u001b[22m\r\n   Tenants\u001b[2m  sites\u001b[22m\r\n   Users\u001b[2m  roles and tenant membership\u001b[22m\r\n   Access\u001b[2m  who can read/create/update/delete\u001b[22m\r\n   Data\u001b[2m  browse and edit documents\u001b[22m\r\n   Run\u001b[2m  dev, build, types, migrate\u001b[22m\r\n   Doctor\u001b[2m  check the setup\u001b[22m\r\n   Headless\u001b[2m  make it backend only\u001b[22m\r\n   Quit\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n \u001b[2m\u2191\u2193 move  \u00b7  Enter open  \u00b7  ? help  \u00b7  q quit\u001b[22m\u001b[?2026l"]
[21.027, "o", "\u001b[?2026h\u001b[2J\u001b[3J\u001b[H\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\r\n\u2502 \u001b[1m\u001b[36mkitgrove\u001b[39m\u001b[22m \u00b7 my-cms\u001b[2m \u00b7 Collections\u001b[22m                                                                  \u2502\r\n\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\r\n\r\n \u001b[1m\u001b[2m  COLLECTION    TENANT-SCOPED  FIELDS  FILE                      \u001b[22m\r\n \u001b[1m\u001b[36m\u203a case-studies  yes            3       collections/CaseStudies.ts\u001b[39m\u001b[22m\r\n   categories    yes            2       collections/Categories.ts\r\n   footer        yes            1       collections/Footer.ts\r\n   header        yes            1       collections/Header.ts\r\n   media         yes            1       collections/Media.ts\r\n   pages         yes            4       collections/Pages.ts\r\n   posts     