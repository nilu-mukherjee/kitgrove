[14.694, "o", "\r\n"]
[14.699, "o", "import type { CollectionConfig } from 'payload'\r\n\r\nimport { tenantEditorOrAdmin } from '../access/tenantEditorOrAdmin'\r\n\r\nexport const CaseStudies: CollectionConfig = {\r\n  slug: 'case-studies',\r\n  access: {\r\n    read: () => true,\r\n    update: tenantEditorOrAdmin,\r\n  },\r\n  admin: {\r\n    useAsTitle: 'client',\r\n  },\r\n  fields: [\r\n    {\r\n      name: 'client',\r\n      type: 'text',\r\n      required: true,\r\n      unique: true,\r\n    },\r\n    {\r\n      name: 'summary',\r\n      type: 'textarea',\r\n    },\r\n    {\r\n      name: 'status',\r\n      type: 'select',\r\n      defaultValue: 'draft',\r\n      options: ['draft', 'live'],\r\n    },\r\n  ],\r\n}\r\n"]
