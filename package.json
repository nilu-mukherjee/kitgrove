{
  "name": "kitgrove",
  "version": "0.1.3",
  "description": "CLI to create and manage multi-tenant Payload CMS projects",
  "type": "module",
  "bin": {
    "kitgrove": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "ink": "^6.8.0",
    "react": "^19.3.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "author": "Nilu Mukherjee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nilu-mukherjee/kitgrove.git"
  },
  "bugs": {
    "url": "https://github.com/nilu-mukherjee/kitgrove/issues"
  },
  "homepage": "https://github.com/nilu-mukherjee/kitgrove#readme",
  "funding": {
    "type": "individual",
    "url": "https://ko-fi.com/nilustack"
  },
  "keywords": [
    "payload",
    "payloadcms",
    "payload-cms",
    "cms",
    "headless-cms",
    "multi-tenant",
    "cli",
    "tui",
    "scaffold"
  ]
}
